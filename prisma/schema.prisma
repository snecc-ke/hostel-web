generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role          String   @default("SEEKER")
  accountStatus String @default("ACTIVE")
  isVerified    Boolean  @default(false)
  createdAt    DateTime @default(now())

  listings         Listing[]      @relation("LandlordListings")
  inquiriesSent    Inquiry[]      @relation("SeekerInquiries")
  reviews          Review[]
  savedListings    SavedListing[]
  bookingsMade     Booking[]      @relation("SeekerBookings")
  reviewedListings Listing[]      @relation("ListingReviewer")
  reportsFiled     Report[]       @relation("ReportsFiled")

  @@map("users")
}

model Listing {
  id              String        @id @default(uuid())
  landlordId      String
  landlord        User          @relation("LandlordListings", fields: [landlordId], references: [id])
  title           String
  description     String
  propertyType    String
  price           Float
  county          String
  area            String
  landmark        String?
  latitude        Float?
  longitude       Float?
  status          String        @default("PENDING")
  rejectionReason String?
  reviewedById    String?
  reviewedBy      User?         @relation("ListingReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  photos    Photo[]
  rooms     Room[]
  inquiries Inquiry[]
  reviews   Review[]
  savedBy   SavedListing[]
  bookings  Booking[]
  payments  Payment[]
  reports   Report[]

  @@map("listings")
  @@index([county, area])
  @@index([status])
  @@index([landlordId])
  @@index([reviewedById])
}

model Photo {
  id        String  @id @default(uuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@map("photos")
  @@index([listingId])
}

model Room {
  id           String      @id @default(uuid())
  listingId    String
  listing      Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  roomNumber   String?
  roomCode     String?
  roomType     String
  cost         Float
  details      String?
  status       String      @default("AVAILABLE")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  photos       RoomPhoto[]
  bookings     Booking[]

  @@map("rooms")
  @@index([listingId])
}

model RoomPhoto {
  id        String  @id @default(uuid())
  roomId    String
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@map("room_photos")
  @@index([roomId])
}

model Inquiry {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seekerId  String
  seeker    User     @relation("SeekerInquiries", fields: [seekerId], references: [id])
  message   String
  createdAt DateTime @default(now())

  @@map("inquiries")
  @@index([listingId])
  @@index([seekerId])
}

model Review {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seekerId  String
  seeker    User     @relation(fields: [seekerId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@map("reviews")
  @@index([listingId])
  @@index([seekerId])
}

model Booking {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  seekerId  String
  seeker    User     @relation("SeekerBookings", fields: [seekerId], references: [id])
  fullName  String   @default("")
  phone     String   @default("")
  message   String?
  amountPaid Float   @default(0)
  amountDue  Float   @default(0)
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bookings")
  @@index([listingId])
  @@index([roomId])
  @@index([seekerId])
}

model SavedListing {
  id        String  @id @default(uuid())
  seekerId  String
  seeker    User    @relation(fields: [seekerId], references: [id])
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([seekerId, listingId])
  @@map("saved_listings")
  @@index([listingId])
}

model Payment {
  id        String         @id @default(uuid())
  listingId String
  listing   Listing        @relation(fields: [listingId], references: [id])
  amount    Float
  purpose   String
  status    String          @default("PENDING")
  createdAt DateTime       @default(now())

  @@map("payments")
  @@index([listingId])
}

model Report {
  id         String  @id @default(uuid())
  listingId  String
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User    @relation("ReportsFiled", fields: [reporterId], references: [id])
  reason     String
  status     String  @default("OPEN")
  createdAt  DateTime @default(now())

  @@map("reports")
  @@index([listingId])
  @@index([status])
}
